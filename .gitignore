# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Harness runtime state
runs/*
!runs/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Model weights and benchmark data are never committed (26 GB+)
weights/
data/
*.glb
*.npz
*.ckpt
*.safetensors
!tests/**/*.glb

# Secrets. Broad on purpose: `.env` alone would not have caught `runpod.env`.
.env
.env.*
*.env
*.key
*secret*
!.env.example

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Wheels telecharges pour inspection (ils ont deja fait exploser un push a 493 Mo)
*.whl

# Derives des photos reelles. Les 18 originaux (piece_test/view01..18.jpg) sont la source
# versionnee ; tout le reste se recalcule a partir d'eux et pese ~30 Mo d'incompressible.
#   upright/ = EXIF Orientation applique + reduction a 2048 px
#   preview/ = vignettes PNG carrees
#   video/   = diaporamas mp4 des 18 vues
piece_test/upright/
piece_test/preview/
piece_test/video/
piece_upright.tgz

# Captures d'ecran de mise au point de la GUI
*.tmp.png
