# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Harness runtime state
runs/*
!runs/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Model weights and benchmark data are never committed (26 GB+)
weights/
data/
*.glb
*.npz
*.ckpt
*.safetensors
!tests/**/*.glb

# Secrets. Broad on purpose: `.env` alone would not have caught `runpod.env`.
.env
.env.*
*.env
*.key
*secret*
!.env.example

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Wheels telecharges pour inspection (ils ont deja fait exploser un push a 493 Mo)
*.whl
